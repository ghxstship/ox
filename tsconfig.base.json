{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": true,
    "paths": {
      "@ox/ds": ["./packages/ds/src/index.ts"],
      "@ox/ds/*": ["./packages/ds/src/*"],
      "@ox/types": ["./packages/types/src/index.ts"],
      "@ox/rbac": ["./packages/rbac/src/index.ts"],
      "@ox/api-client": ["./packages/api-client/src/index.ts"],
      "@ox/supabase": ["./packages/supabase/src/index.ts"],
      "@ox/supabase/server": ["./packages/supabase/src/server.ts"],
      "@ox/supabase/types": ["./packages/supabase/src/database.types.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
