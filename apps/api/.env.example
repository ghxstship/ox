# OX API — copy to .env and fill. Plug in. Level up.
PORT=4000
DATABASE_URL=postgresql://ox:ox@localhost:5432/ox?schema=public
JWT_SECRET=dev-secret-change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEB_ORIGIN=http://localhost:3000

# Booking: free-cancel window in hours (inside it → late_cancel + penalty fee).
OX_CANCEL_CUTOFF_HOURS=12
# OTP delivery: when set, dispatch is treated as "sent" (logged); else console.
OX_MAILER_FROM=

# Backend of record: Supabase xaepcwnqjwphuwvuekfb. Set [PASSWORD] from the dashboard.
# DATABASE_URL="postgresql://postgres.xaepcwnqjwphuwvuekfb:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xaepcwnqjwphuwvuekfb:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# Privileged service client (webhooks/admin that bypass RLS):
SUPABASE_SERVICE_ROLE_KEY=
# Supabase token bridge (accept Supabase access tokens + RLS-via-token reads).
NEXT_PUBLIC_SUPABASE_URL=https://xaepcwnqjwphuwvuekfb.supabase.co
# One verifies Supabase tokens; with neither set the API decodes-and-trusts
# (dev only) and warns. Production MUST set one.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
