{
  "name": "@ox/api",
  "version": "1.0.0",
  "private": true,
  "description": "OX API — NestJS backend. JWT → Postgres GUC → RLS. Plug in. Level up.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "watch": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo ok",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@ox/db": "workspace:*",
    "@ox/rbac": "workspace:*",
    "@ox/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/swagger-ui-express": "^4.1.6",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
