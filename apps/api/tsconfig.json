{
  "extends": "../../packages/config/tsconfig.node.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "incremental": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "paths": {
      "@ox/rbac": ["../../packages/rbac/src/index.ts"],
      "@ox/types": ["../../packages/types/src/index.ts"],
      "@ox/api-client": ["../../packages/api-client/src/index.ts"],
      "@ox/supabase": ["../../packages/supabase/src/index.ts"],
      "@ox/supabase/server": ["../../packages/supabase/src/server.ts"],
      "@ox/supabase/types": ["../../packages/supabase/src/database.types.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".turbo"],
  "ts-node": {
    "transpileOnly": true,
    "preferTsExts": true,
    "experimentalResolver": true,
    "require": ["tsconfig-paths/register"],
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node"
    },
    "moduleTypes": {
      "../../packages/supabase/src/**/*.ts": "cjs",
      "../../packages/rbac/src/**/*.ts": "cjs"
    }
  }
}
