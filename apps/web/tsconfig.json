{
  "extends": "../../packages/config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@ox/ds": ["../../packages/ds/src/index.ts"],
      "@ox/ds/*": ["../../packages/ds/src/*"],
      "@ox/ds/whitelabel": ["../../packages/ds/whitelabel/apply-brand.d.ts"],
      "@ox/rbac": ["../../packages/rbac/src/index.ts"],
      "@ox/api-client": ["../../packages/api-client/src/index.ts"],
      "@ox/types": ["../../packages/types/src/index.ts"],
      "@ox/supabase": ["../../packages/supabase/src/index.ts"],
      "@ox/supabase/server": ["../../packages/supabase/src/server.ts"],
      "@ox/supabase/types": ["../../packages/supabase/src/database.types.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".turbo"]
}
