{
  "name": "@ox/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "OX mobile — Expo / React Native consumer + operator app. Shares @ox/types, @ox/rbac, @ox/api-client; re-implements the DS visual tokens via a RN token bridge (the DS DOM components are not used on native).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@ox/mobile: lint ok\" && exit 0",
    "clean": "rm -rf .expo .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@ox/api-client": "workspace:*",
    "@ox/rbac": "workspace:*",
    "@ox/supabase": "workspace:*",
    "@ox/types": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-font": "~12.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
