NEXT_PUBLIC_SUPABASE_URL="https://xaepcwnqjwphuwvuekfb.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_ZzRzJgf-NQ3g5sR6i48m8g_HbMD_DMM"

# Server-only (NEVER ship to the browser)
