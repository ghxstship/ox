// OX — Prisma schema. Derived 1:1 from design_handoff_ox_app/02-data-model.md.
// Every tenant-data table carries floorId and/or coachId/ownerId so the RLS
// policies in prisma/migrations/rls/policies.sql (06) can scope it.
// IDs are cuid; createdAt/updatedAt on all mutable tables.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Supabase Postgres (project xaepcwnqjwphuwvuekfb). DATABASE_URL is the pooled
// (pgBouncer :6543) connection for the app; DIRECT_URL is the direct (:5432)
// connection Prisma uses for `migrate` / `db pull`. The live DB is already
// migrated + seeded — run `prisma db pull` to sync this schema; do NOT migrate
// or seed against it. See db/SUPABASE.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums (OX vocabulary) ───────────────────────────────────────────
enum Role {
  member
  coach
  host
  admin
}

enum Tier {
  compass
  sound
  distant
  founder
}

enum ClassLoad {
  open
  fill
  full
}

enum BookingState {
  booked
  waitlist
  attended
  late_cancel
  no_show
  cancelled
}

enum PayState {
  pending
  paid
  failed
  refunded
}

enum OrderState {
  cart
  placed
  paid
  fulfilled
  cancelled
}

enum TicketState {
  reserved
  paid
  checked_in
  refunded
}

enum Scenery {
  oceanfront
  rooftop
  industrial
  sunrise
  forest
}

enum Muscle {
  push
  pull
  legs
  core
  full_body
  arms
  back
  chest
  glutes
}

enum Equipment {
  barbell
  dumbbell
  kettlebell
  cable
  machine
  band
  bodyweight
  trx
}

// ── Identity & tenancy ──────────────────────────────────────────────
model User {
  id          String   @id @default(cuid())
  authUserId  String?  @unique @db.Uuid // ↔ Supabase auth.users.id (RLS: auth.uid())
  name        String
  email       String   @unique
  initial     String
  role        Role
  level       Int      @default(1)
  xp          Int      @default(0)
  bio         String?
  handle      String?  @unique
  homeFloorId String?
  coachId     String? // member -> their coach
  coach       User?    @relation("Roster", fields: [coachId], references: [id])
  roster      User[]   @relation("Roster")
  floorId     String? // host -> owned floor; member -> home floor (CRM)
  floor       Floor?   @relation("FloorMembers", fields: [floorId], references: [id])
  ownedFloors Floor[]  @relation("FloorHost")

  bookings    Booking[]
  orders      Order[]
  tickets     Ticket[]
  sessions    WorkoutSession[]
  posts       Post[]
  herds       Herd[]
  memberships Membership[]
  payments    Payment[]
  prs         PR[]
  recovery    Recovery[]
  quests      Quest[]
  challengeEntries ChallengeEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([coachId])
  @@index([floorId])
}

model Floor {
  id        String           @id @default(cuid())
  name      String
  scenery   Scenery
  hostId    String // owning host (User.role=host)
  host      User             @relation("FloorHost", fields: [hostId], references: [id])
  address   String?
  geo       Json? // {lat,lng}
  stripeAccountId String? // Stripe Connect — partner-floor payouts
  equipment FloorEquipment[]
  classes   Class[]
  members   User[]           @relation("FloorMembers")
  payments  Payment[]
  memberships Membership[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([hostId])
}

model FloorEquipment {
  id        String    @id @default(cuid())
  floorId   String
  floor     Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  equipment Equipment
  count     Int       @default(1)

  @@index([floorId])
}

// ── Training ────────────────────────────────────────────────────────
model Exercise {
  id        String      @id @default(cuid())
  name      String
  muscles   Muscle[]
  equipment Equipment[]
  demoUrl   String?
  cue       String?
  sets      SetLog[]

}

model WorkoutSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  floorId   String?
  scenery   Scenery?
  startedAt DateTime
  endedAt   DateTime?
  xpAwarded Int       @default(0)
  sets      SetLog[]
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SetLog {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  index      Int
  weight     Float?
  reps       Int
  rpe        Int?
  done       Boolean        @default(false)

  @@index([sessionId])
}

model PR {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lift   String
  value  Float
  unit   String   @default("lb")
  at     DateTime @default(now())

  @@index([userId])
}

model Recovery {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle Muscle
  state  String // fresh|light|worked|spent

  @@id([userId, muscle])
}

// ── Classes & booking ───────────────────────────────────────────────
model Class {
  id        String    @id @default(cuid())
  title     String
  floorId   String // RLS: host scope
  floor     Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  coachId   String // RLS: coach scope
  startsAt  DateTime
  capacity  Int
  load      ClassLoad @default(open)
  recurRule String? // RRULE for recurring
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([floorId])
  @@index([coachId])
}

model Booking {
  id          String       @id @default(cuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  state       BookingState @default(booked)
  waitlistPos Int?
  createdAt   DateTime     @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

// ── Events / raids ──────────────────────────────────────────────────
model Event {
  id       String       @id @default(cuid())
  title    String
  floorId  String?
  hostName String
  startsAt DateTime
  rewardXp Int          @default(0)
  capacity Int?
  isRaid   Boolean      @default(false)
  tiers    TicketTier[]
  tickets  Ticket[]
  createdAt DateTime    @default(now())

}

model TicketTier {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int
  qty        Int
  tickets    Ticket[]

  @@index([eventId])
}

model Ticket {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierId      String
  tier        TicketTier  @relation(fields: [tierId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  state       TicketState @default(reserved)
  qrCode      String      @unique
  checkedInAt DateTime?

  @@index([userId])
  @@index([eventId])
}

// ── Memberships & payments ──────────────────────────────────────────
model Membership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  floorId     String
  floor       Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tier        Tier
  addOns      String[]
  status      String // active|paused|cancelled|past_due
  renewsAt    DateTime?
  stripeSubId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([floorId])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  floorId     String // RLS: host scope; Connect payout target
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  kind        String // Membership|Private coaching|Workshop|Shop|Ticket|Founder tier
  amountCents Int
  state       PayState @default(pending)
  stripePiId  String?
  at          DateTime @default(now())

  @@index([floorId])
  @@index([userId])
}

// ── Commerce ────────────────────────────────────────────────────────
model Product {
  id         String      @id @default(cuid())
  name       String
  priceCents Int
  collection String // "new", "drop", etc.
  sizes      String[]
  colors     String[]
  imageUrl   String?
  gateLevel  Int         @default(0) // level-gated drops (0 = open)
  items      OrderItem[]

}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  state      OrderState  @default(cart)
  totalCents Int         @default(0)
  items      OrderItem[]
  placedAt   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  size       String
  qty        Int
  priceCents Int

  @@index([orderId])
}

// ── Social & game ───────────────────────────────────────────────────
model Tribe {
  id        String   @id @default(cuid())
  name      String
  memberIds String[]

}

model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  mediaUrl  String?
  herds     Herd[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Herd {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // "Herd that" reaction
}

model Challenge {
  id       String           @id @default(cuid())
  title    String
  startsAt DateTime
  endsAt   DateTime
  metric   String
  rewardXp Int
  entries  ChallengeEntry[]

}

model ChallengeEntry {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Float     @default(0)

  @@index([challengeId])
}

model Quest {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  target  Int
  current Int    @default(0)
  state   String

  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
// Parity tables (operator + consumer). Added 2026-06-28 for full
// end-to-end functionality. Scalar FKs only (navigation omitted to keep the
// hand-maintained schema localized); the live DB holds the real FKs + RLS.
// ════════════════════════════════════════════════════════════════════

enum LeadStage {
  lead
  tour
  trial
  member
  lost
}

enum AutomationTrigger {
  signup
  booking
  missed_class
  membership_lapsed
}

enum ShiftKind {
  class
  floor
  open
}

enum NotificationKind {
  system
  coach
  social
  commerce
  booking
  quest
}

enum HealthProvider {
  apple_health
  google_fit
  garmin
  whoop
  fitbit
}

enum DiscountKind {
  percent
  fixed
}

enum CreditReason {
  purchase
  booking
  refund
  gift
  adjustment
  referral
}

model Lead {
  id         String    @id @default(cuid())
  floorId    String
  name       String
  contact    String
  source     String    @default("walk_in")
  stage      LeadStage @default(lead)
  notes      String?
  valueCents Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([floorId])
}

model LeadActivity {
  id      String   @id @default(cuid())
  leadId  String
  floorId String
  kind    String
  note    String   @default("")
  at      DateTime @default(now())

  @@index([leadId])
}

model Automation {
  id         String            @id @default(cuid())
  floorId    String
  name       String?
  trigger    AutomationTrigger
  action     String
  delayHours Int               @default(0)
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([floorId])
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  floorId      String
  at           DateTime @default(now())
  result       String   @default("")

  @@index([automationId])
}

model Shift {
  id             String    @id @default(cuid())
  floorId        String
  staffId        String
  startsAt       DateTime
  endsAt         DateTime
  kind           ShiftKind @default(floor)
  coverRequested Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([floorId])
  @@index([staffId])
}

model Agreement {
  id        String   @id @default(cuid())
  floorId   String
  title     String
  body      String
  version   Int      @default(1)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([floorId])
}

model Signature {
  id          String   @id @default(cuid())
  agreementId String
  floorId     String
  userId      String
  dataUrl     String
  signedAt    DateTime @default(now())

  @@index([agreementId])
}

model WebhookEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind @default(system)
  title     String
  body      String           @default("")
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  at         DateTime @default(now())
  weightLb   Float?
  bodyFatPct Float?
  restingHr  Int?
  notes      String?

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String   @default("")
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

model ShippingAddress {
  id        String   @id @default(cuid())
  userId    String
  name      String
  line1     String
  line2     String?
  city      String
  region    String
  postal    String
  country   String   @default("US")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model CreditLedger {
  id           String       @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       CreditReason @default(adjustment)
  note         String?
  at           DateTime     @default(now())

  @@index([userId])
}

model Pack {
  id         String   @id @default(cuid())
  floorId    String?
  name       String
  credits    Int
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model UserPack {
  id               String    @id @default(cuid())
  userId           String
  packId           String
  creditsRemaining Int
  purchasedAt      DateTime  @default(now())
  expiresAt        DateTime?

  @@index([userId])
}

model GiftCard {
  id            String   @id @default(cuid())
  code          String   @unique
  balanceCents  Int
  initialCents  Int
  purchaserId   String?
  recipientEmail String?
  redeemedById  String?
  createdAt     DateTime @default(now())
}

model PromoCode {
  id             String       @id @default(cuid())
  code           String       @unique
  kind           DiscountKind @default(percent)
  value          Int
  active         Boolean      @default(true)
  maxRedemptions Int?
  timesRedeemed  Int          @default(0)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
}

model Waiver {
  id        String   @id @default(cuid())
  floorId   String?
  title     String
  body      String
  version   Int      @default(1)
  createdAt DateTime @default(now())
}

model WaiverSignature {
  id       String   @id @default(cuid())
  waiverId String
  userId   String
  signedAt DateTime @default(now())

  @@unique([waiverId, userId])
  @@index([userId])
}

model HealthConnection {
  id          String         @id @default(cuid())
  userId      String
  provider    HealthProvider
  status      String         @default("connected")
  connectedAt DateTime       @default(now())

  @@unique([userId, provider])
}

model GuestPass {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  guestName String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OnboardingState {
  userId    String   @id
  step      Int      @default(0)
  completed Boolean  @default(false)
  data      Json     @default("{}")
  updatedAt DateTime @default(now())
}
