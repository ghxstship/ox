{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/editorial/**",
              "components/feedback/**",
              "components/fitness/**",
              "components/forms/**",
              "components/game/**",
              "components/layout/**",
              "components/media/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/product/**",
              "components/xr/**",
              "design_handoff_ox_app/references/_app/**",
              "design_handoff_ox_app/references/ox-mobile/**",
              "design_handoff_ox_app/references/ox-web/**",
              "marketing/**",
              "ui_kits/_app/**",
              "ui_kits/iron-safari/**",
              "ui_kits/member-app/**",
              "ui_kits/ox-mobile/**",
              "ui_kits/ox-web/**",
              "ui_kits/storefront/**",
              "whitelabel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Serif Display|Geist|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: DM Serif Display, Geist, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXAlert'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<OXAlert> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXAppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|appCode|brand|nav|topbar|children|style|key|ref|className|style|children)$/]",
        "message": "<OXAppShell> doesn't accept that prop. Declared props: product, appCode, brand, nav, topbar, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXXRFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:device|status|eyeConnect|hint|children|key|ref|className|style|children)$/]",
        "message": "<OXXRFrame> doesn't accept that prop. Declared props: device, status, eyeConnect, hint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|arrow|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<OXButton> doesn't accept that prop. Declared props: variant, size, block, arrow, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|oxide|ghost)$/]",
        "message": "<OXButton> variant must be one of 'default' | 'primary' | 'oxide' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<OXButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|category|title|description|status|meta|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OXCard> doesn't accept that prop. Declared props: day, category, title, description, status, meta, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|live|children|style|key|ref|className|style|children)$/]",
        "message": "<OXChip> doesn't accept that prop. Declared props: variant, live, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|solid|oxide|oxide-line|ghost)$/]",
        "message": "<OXChip> variant must be one of 'default' | 'solid' | 'oxide' | 'oxide-line' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OXChoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|name|label|sub|checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<OXChoice> doesn't accept that prop. Declared props: type, name, label, sub, checked, disabled, onChange, style."
