        "selector": "JSXOpeningElement[name.name='OXInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|state|multiline|rows|onChange|style|key|ref|className|style|children)$/]",
        "message": "<OXInput> doesn't accept that prop. Declared props: value, placeholder, state, multiline, rows, onChange, style."
